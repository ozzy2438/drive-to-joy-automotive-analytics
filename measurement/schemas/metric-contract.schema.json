{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drive-to-joy.example/schemas/metric-contract.schema.json",
  "title": "Drive to Joy governed metric contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "effective_from",
    "reporting_timezone",
    "data_origin",
    "quality_status",
    "metrics"
  ],
  "properties": {
    "contract_version": {
      "$ref": "#/$defs/semver"
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "reporting_timezone": {
      "const": "Australia/Melbourne"
    },
    "data_origin": {
      "const": "synthetic"
    },
    "quality_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "precedence", "rule"],
      "properties": {
        "values": {
          "const": ["pass", "warn", "fail", "unknown", "stale"]
        },
        "precedence": {
          "const": ["fail", "stale", "warn", "unknown", "pass"]
        },
        "rule": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 15,
      "items": {
        "$ref": "#/$defs/metric"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "metric_name",
        "metric_version",
        "business_definition",
        "formula",
        "numerator",
        "denominator",
        "grain",
        "dimensions",
        "source_model",
        "source_columns",
        "filter_rules",
        "exclusion_rules",
        "freshness_requirement",
        "quality_dependencies",
        "owner",
        "limitation",
        "acceptance_fixture",
        "reconciliation_query",
        "aggregation_behavior",
        "unit",
        "reporting_timezone",
        "zero_denominator_policy",
        "effective_from",
        "deprecated_at",
        "tolerance"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "metric_name": {
          "type": "string",
          "minLength": 3
        },
        "metric_version": {
          "$ref": "#/$defs/semver"
        },
        "business_definition": {
          "type": "string",
          "minLength": 20
        },
        "formula": {
          "type": "string",
          "minLength": 3
        },
        "numerator": {
          "type": "string",
          "minLength": 1
        },
        "denominator": {
          "type": "string",
          "minLength": 1
        },
        "grain": {
          "type": "string",
          "minLength": 3
        },
        "dimensions": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "source_model": {
          "type": "string",
          "pattern": "^(agg|fct)_[a-z0-9_]+$"
        },
        "source_columns": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "filter_rules": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "exclusion_rules": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "freshness_requirement": {
          "type": "string",
          "minLength": 3
        },
        "quality_dependencies": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "owner": {
          "type": "string",
          "minLength": 3
        },
        "limitation": {
          "type": "string",
          "minLength": 10
        },
        "acceptance_fixture": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
        },
        "reconciliation_query": {
          "type": "string",
          "pattern": "^dashboards/reconciliation/[a-z0-9_]+\\.sql$"
        },
        "aggregation_behavior": {
          "enum": [
            "additive",
            "ratio_of_sums",
            "difference_of_ratios",
            "status"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 2
        },
        "reporting_timezone": {
          "const": "Australia/Melbourne"
        },
        "zero_denominator_policy": {
          "enum": ["zero", "null", "unknown", "not_applicable"]
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "deprecated_at": {
          "type": ["string", "null"],
          "format": "date"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
